        "source": [
          "## Notebook to demonstarte Databricks Connect"
        ]
      },
      {
        "cell_type": "markdown",
        "id": "55c7a23f",
        "metadata": {},
        "source": [
          "#### PySpark code executed in the Databricks Cluster"
        ]
      },
      {
        "cell_type": "code",
        "execution_count": 3,
        "id": "61c276ed",
        "metadata": {},
        "outputs": [],
        "source": [
          "companies_df = spark.read.table(\"demo.silver.companies\") \n",
          "summary_df = companies_df.groupBy(\"country\").count()\n",
          "summary_py = summary_df.collect()   "
        ]
      },
      {
        "cell_type": "markdown",
        "id": "03861303",
        "metadata": {},
        "source": [
          "#### Python code executed in the local machine"
        ]
      },
      {
        "cell_type": "code",
        "execution_count": 4,
        "id": "8424bdf5",
        "metadata": {},
        "outputs": [
          {
            "name": "stdout",
            "output_type": "stream",
            "text": [
              "Total companies across all countries: 6\n"
            ]
          }
        ],
        "source": [
          "total_companies = sum(row['count'] for row in summary_py)\n",
          "print(\"Total companies across all countries:\", total_companies)"
        ]
      }
    ],
